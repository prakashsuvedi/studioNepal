# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# HUGGINGFACE_API_KEY: Optional API token for Hugging Face Inference API.
# Kept strictly server-side; defaults to graceful fallback when unset.
HUGGINGFACE_API_KEY=""
HF_ACCESS_TOKEN=""

# OPENAI_API_KEY: Direct OpenAI API Key for GPT-4o / GPT-4o-mini
OPENAI_API_KEY=""

# AZURE_OPENAI_KEY: Azure OpenAI API Key
AZURE_OPENAI_KEY=""
AZURE_OPENAI_ENDPOINT=""

# STRIPE_SECRET_KEY: Optional secret key for Stripe payment processing.
STRIPE_SECRET_KEY=""

# ADMIN_SECRET_KEY: Secret key for admin session bypass.
ADMIN_SECRET_KEY=""

# GOOGLE_CLIENT_ID & GOOGLE_CLIENT_SECRET: Google Cloud OAuth 2.0 Web Client Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AZURE_SPEECH: Secret key for Azure Cognitive Services Text-to-Speech (location: eastus)
AZURE_SPEECH=""
AZURE_SPEECH_REGION="eastus"

# SUPABASE_POSTGRES_URL: Supabase PostgreSQL Database URL
SUPABASE_POSTGRES_URL="postgresql://postgres.pnqahzcztfvpyfbogrel:Pr@9851312299@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"

