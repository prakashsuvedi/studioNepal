# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# HUGGINGFACE_API_KEY: Optional API token for Hugging Face Inference API.
# Kept strictly server-side; defaults to graceful fallback when unset.
HUGGINGFACE_API_KEY=""
HF_ACCESS_TOKEN=""

# OPENAI_API_KEY: Direct OpenAI API Key for GPT-4o / GPT-4o-mini
OPENAI_API_KEY=""

# AZURE_OPENAI_KEY: Azure OpenAI API Key
AZURE_OPENAI_KEY=""
AZURE_OPENAI_ENDPOINT=""

# STRIPE_SECRET_KEY: Optional secret key for Stripe payment processing.
STRIPE_SECRET_KEY=""

# ADMIN_SECRET_KEY: Secret key for admin session bypass.
ADMIN_SECRET_KEY=""

# GOOGLE_CLIENT_ID & GOOGLE_CLIENT_SECRET: Google Cloud OAuth 2.0 Web Client Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AZURE_SPEECH: Secret key for Azure Cognitive Services Text-to-Speech (location: eastus)
AZURE_SPEECH=""
AZURE_SPEECH_REGION="eastus"

# SUPABASE POSTGRESQL CREDENTIALS
SUPABASE_PG_HOST="aws-0-ap-northeast-2.pooler.supabase.com"
SUPABASE_PG_PORT="5432"
SUPABASE_PG_DATABASE="postgres"
SUPABASE_PG_USER="postgres.pnqahzcztfvpyfbogrel"
SUPABASE_PG_PASSWORD=""

# FONEPAY MERCHANT CREDENTIALS
FONEPAY_MERCHANT_PID="NEPALAI01"
FONEPAY_SECRET_KEY=""
FONEPAY_ENV="LIVE"

# SUPABASE STORAGE
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_BUCKET="nepalai-media"

# PLATFORM ADMIN
ADMIN_PASSWORD=""

# TIKTOK OAUTH CREDENTIALS
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

